# Server
PORT=5000
NODE_ENV=development

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5173

# MongoDB (Atlas URI with replica set for transactions)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=teamnest

# Stripe (test mode)
PAYMENT_GATEWAY_KEY=sk_test_xxx
# Get this from `stripe listen --forward-to localhost:5000/api/webhooks/stripe`
# or the Stripe dashboard webhook endpoint. Leave empty in development to accept
# unsigned payloads (requires NODE_ENV=development).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Firebase Admin (backend token verification)
# Path to the service-account JSON downloaded from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Platform admin seed (user is created in Firebase + MongoDB during `npm run seed`)
PLATFORM_ADMIN_EMAIL=admin@teamnest.dev
PLATFORM_ADMIN_PASSWORD=change-me

# Email (SMTP)
# Leave SMTP_HOST empty in development: emails are captured to preview-emails/
# and logged to the backend console instead of being sent.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=smtp-user
#SMTP_PASS=smtp-pass
#MAIL_FROM=TeamNest <no-reply@teamnest.dev>
# Firebase Auth Web API key (used to verify the current password on change)
WEB_API_KEY=

# Security
# Set TRUST_PROXY=true when running behind a reverse proxy (nginx, Heroku, ...)
# so rate limits key off the real client IP.
#TRUST_PROXY=true
# Global API rate limit per IP per 15 minutes (default 600)
#RATE_LIMIT_MAX=600